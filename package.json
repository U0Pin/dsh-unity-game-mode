{
  "name": "dsh-unity-game-mode",
  "version": "0.1.1",
  "description": "A Unity game development mode for DeepSeek Harness: the full ptc preset plus the Unity Editor MCP connection, fronted by a session-surviving bridge.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "unity",
    "unity-mcp",
    "mcp",
    "agent-preset"
  ],
  "license": "MIT",
  "author": "U0Pin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/U0Pin/dsh-unity-game-mode.git"
  },
  "homepage": "https://github.com/U0Pin/dsh-unity-game-mode#readme",
  "bugs": {
    "url": "https://github.com/U0Pin/dsh-unity-game-mode/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./bridge": "./bridge.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bridge.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "DEVELOPMENT.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node test/plugin-contract.test.mjs && node test/bridge.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
